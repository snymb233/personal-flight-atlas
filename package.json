{
  "name": "personal-flight-atlas",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "prebuild": "node scripts/prepare-cloud.mjs",
    "check:cloud": "tsc --project tsconfig.worker.json && node tests/check-cloud.mjs",
    "deploy:cloud": "npm run build && npm run check:cloud && npx --yes wrangler@4.152.0 pages deploy dist --project-name personal-flight-atlas --branch main",
    "check:world": "node tests/check-world.ts"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "lucide-react": "1.53.0",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/d3-geo": "3.1.1",
    "@types/node": "26.6.4",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "flag-icons": "7.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
