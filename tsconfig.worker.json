{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true, "skipLibCheck": true,
    "lib": ["ES2023"], "types": ["@cloudflare/workers-types"]
  },
  "include": ["worker/**/*.ts", "functions/**/*.ts"]
}
